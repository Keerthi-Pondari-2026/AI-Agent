# Copy to .env.local in this folder (same directory as package.json)
# Get values from Supabase → Project Settings → API

# Project URL from Supabase → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key_here

# FastAPI backend (Gemini) — local dev
VITE_API_URL=http://localhost:8000
